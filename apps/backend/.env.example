# Server port
PORT=4000

# Hasura admin credentials — this service is the ONLY place these may live.
# Never copy them into apps/frontend's environment (see its README).
HASURA_GRAPHQL_URL=<your-hasura-instance>/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=<your-hasura-admin-secret>

# Shared secret apps/frontend sends on server-to-server calls into this
# service's /internal/* routes. Generate a long random value and set the
# same one in apps/frontend's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=<a-long-random-shared-secret>
